# Harborstone Mobile — environment variables.
# Set these in Vercel: Project → Settings → Environment Variables. NEVER commit real values.
# These are SEPARATE from Prosperity Mobile (different names, different secret, different email setup).

# --- Demo sign-in (required) ---
HM_LOGIN_EMAIL=jessicabrownn088@gmail.com
HM_LOGIN_PASSWORD=choose-a-strong-demo-password
# Where the OTP email is sent (optional; defaults to HM_LOGIN_EMAIL)
HM_OTP_TO=jessicabrownn088@gmail.com
# Long random string (24+ chars) used to seal OTP tokens. Generate: openssl rand -base64 32
HM_OTP_SECRET=replace-with-a-long-random-secret

# --- Email provider option A: Resend (recommended) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must use a domain you verified in Resend (or Resend's test sender onboarding@resend.dev, which only delivers to your own Resend account email)
HM_FROM_EMAIL=Harborstone Bank <no-reply@your-verified-domain.com>

# --- Email provider option B: SMTP (e.g. a Gmail App Password) — used only if RESEND_API_KEY is not set ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=your-google-app-password
# HM_FROM_NAME=Harborstone Bank

# --- Development-only OTP testing mode (optional) ---
# When "true" AND email is not configured/working, the API returns the code so you can test the flow.
# It is ignored automatically on Vercel Production deployments (VERCEL_ENV=production).
# HM_DEV_OTP=true
